# Local preview only. No credentials are included.
# Node reads exported variables; the app does not auto-load .env.
# With Node22+, use: node --env-file=.env server/main.mjs
CUSTOMER_PORT=5173
ADMIN_PORT=5174
API_PORT=8787
# Optional private durable journal/Sheet fixture/upload directory; default ./data.
# LHF_DATA_DIR=/absolute/path/to/a/separate/local-demo-data-directory

# Image provider is disconnected unless an endpoint is explicitly supplied.
# Keep unset for the included eight curated concepts and no outbound generation.
# An endpoint must implement server/preview-service.mjs HttpConceptProvider contract.
# A real paid endpoint needs explicit authorization; use a local mock for tests.
# LHF_IMAGE_PROVIDER_ENDPOINT=http://127.0.0.1:8999/generate
# LHF_IMAGE_PROVIDER_TOKEN=
# Declared provider model/version changes the generated preview cache identity.
# LHF_CONCEPT_MODEL_VERSION=configured-v1
# Estimated provider cost in cents per request, reserved against the local cumulative500-cent cap.
# LHF_IMAGE_COST_CENTS=0
# Provider limits are declared in server/preview-service.mjs PREVIEW_LIMITS:
# 45s timeout, one explicit retry, two active jobs/session,12queued jobs,
# 30requests/hour/session,250ready cache entries,8MiB/16MP image limits.

# Google Sheets is not connected by an environment switch in this preview.
# GoogleSheetsAdapter requires explicit sandbox:true, spreadsheetId, server tokenProvider
# and verified owned-column mapping supplied by a separately authorized integration.
# Do not add a live Sheet ID, Apps Script URL or production credentials here.
# Demo role selection remains loopback-only and is not production authentication.

# Background preview helper uses the default ports above. For alternate ports/data
# use npm start (or node --env-file=.env server/main.mjs) directly.
